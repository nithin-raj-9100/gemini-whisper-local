# Keep the real key in your shell or an untracked .env file.
GEMINI_API_KEY=

# Optional daemon settings.
GEMINI_WHISPER_HOST=127.0.0.1
GEMINI_WHISPER_PORT=8765

# Optional ffmpeg microphone device. macOS commonly uses :0.
GEMINI_WHISPER_AUDIO_DEVICE=:0
GEMINI_WHISPER_LANGUAGE=en-IN
GEMINI_WHISPER_TRANSPORT=native
GEMINI_WHISPER_HOTKEY_PORT=8766
