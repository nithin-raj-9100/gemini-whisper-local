# Keep the real key in your shell or an untracked .env file. Never commit this file.
# The bundled app moves this key into the login Keychain on first launch; after
# that it can be removed here. It can also be entered in Settings instead.
GEMINI_API_KEY=

# BCP-47 language hint (empty in the app Settings means autodetect).
GEMINI_WHISPER_LANGUAGE=en-IN

# Microphone: empty or :0 means the system default input.
# To pin a device, set its AVCapture uniqueID (shown in Settings).
GEMINI_WHISPER_AUDIO_DEVICE=:0

# Capture/drain margin after Right Option stop (ms).
# GEMINI_WHISPER_STOP_TAIL_MS=400

# Optional Flash-Lite model override for the polish pass.
# GEMINI_WHISPER_INTELLIGENCE_MODEL=gemini-3.5-flash-lite

# Model that transcribes the recorded audio when Live fails, reconnects, or
# returns nothing. Defaults to the polish model.
# GEMINI_WHISPER_BATCH_MODEL=gemini-3.5-flash-lite

# Longest wait (ms) for the final polish after stop before inserting the raw
# transcript. Default: 2.5 s plus 15 ms per word, capped at 8 s.
# GEMINI_WHISPER_POLISH_DEADLINE_MS=8000

# Optimistic paste: insert the raw transcript as soon as it settles, then
# replace it once polish lands, only where Accessibility can verify the
# inserted text. Off by default and controlled by the Settings toggle; set
# this only to force a value and ignore the toggle (0 disables, 1 enables).
# GEMINI_WHISPER_OPTIMISTIC_PASTE=0
