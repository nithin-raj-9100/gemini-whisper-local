{
  "title": "Gemini Whisper",
  "rules": [
    {
      "description": "Right Option toggles Gemini Whisper system dictation",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_option",
            "modifiers": { "optional": ["any"] }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 500
          },
          "to": [
            {
              "key_code": "right_option",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "shell_command": "/usr/bin/curl -fsS -X POST http://127.0.0.1:8766/toggle >/dev/null 2>&1"
            }
          ]
        }
      ]
    }
  ]
}
